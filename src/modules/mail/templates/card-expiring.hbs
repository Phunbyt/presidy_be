<table width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; margin: 0 auto; font-family: 'Arial', sans-serif; color: #333333;">
  <!-- Header Section -->
  <tr>
    <td style="padding: 25px 0; text-align: center; background-color: #FFF8E1; border-bottom: 3px solid #FFA000;">
      <img src="https://d3ezi03spn2dw7.cloudfront.net/darkLogo.png" alt="Presidy Logo" width="140" style="max-width: 140px;">
      <h2 style="color: #FF8F00; margin: 15px 0 0 0;">💳 Your Card Is Expiring Soon</h2>
    </td>
  </tr>

  <!-- Main Content -->
  <tr>
    <td style="padding: 30px 20px;">
      <h3 style="color: #2A5CBE; margin: 0 0 15px 0;">Hi {{name}},</h3>
      <p style="font-size: 15px; line-height: 1.6; margin: 0 0 20px 0;">
        The card linked to your <strong>{{planName}}</strong> subscription is about to expire.
        Update it now to avoid any interruption to your access.
      </p>

      <!-- Action Button -->
      <div style="text-align: center; margin-top: 30px;">
        <a href="https://presidy.com/dashboard"
           style="display: inline-block;
                  background: #2A5CBE;
                  color: white;
                  padding: 12px 40px;
                  border-radius: 5px;
                  text-decoration: none;
                  font-weight: bold;">
          Update Card Details →
        </a>
      </div>
    </td>
  </tr>

  <!-- Footer -->
  <tr>
    <td style="background: #f8f9ff; padding: 25px 20px; text-align: center;">
      <p style="font-size: 12px; color: #666666; margin: 0 0 15px 0;">
        Best wishes,<br>
        The Presidy Team 🌟
      </p>
    </td>
  </tr>
</table>

{{>footer}}
