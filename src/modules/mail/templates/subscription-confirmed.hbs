<table width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; margin: 0 auto; font-family: 'Arial', sans-serif; color: #333333;">
  <!-- Header Section -->
  <tr>
    <td style="padding: 30px 0; text-align: center; background-color: #f8f9ff;">
      <img src="https://d3ezi03spn2dw7.cloudfront.net/darkLogo.png" alt="Presidy Logo" width="160" style="max-width: 160px;">
    </td>
  </tr>

  <!-- Main Content -->
  <tr>
    <td style="padding: 40px 20px;">
      <h1 style="color: #2A5CBE; margin: 0 0 15px 0;">You're All Set, {{name}}! ✅</h1>
      <p style="font-size: 16px; line-height: 1.6; margin: 0 0 25px 0;">
        Your subscription to <strong>{{planName}}</strong> is now active and will renew automatically.
      </p>

      <!-- Details Card -->
      <div style="background: #F8F9FF; padding: 25px; margin: 30px 0; border-radius: 8px;">
        <p style="margin: 0; color: #666; font-size: 14px;">Plan</p>
        <p style="margin: 0; font-weight: bold; color: #2A5CBE;">{{planName}}</p>
        <p style="margin: 15px 0 0 0; color: #666; font-size: 14px;">Amount</p>
        <p style="margin: 0; font-weight: bold; color: #2A5CBE;">{{amount}}</p>
      </div>

      <div style="text-align: center; margin-top: 30px;">
        <a href="https://presidy.com/dashboard"
           style="display: inline-block;
                  background: #2A5CBE;
                  color: white;
                  padding: 12px 40px;
                  border-radius: 5px;
                  text-decoration: none;
                  font-weight: bold;">
          Go to Dashboard →
        </a>
      </div>
    </td>
  </tr>

  <!-- Footer -->
  <tr>
    <td style="background: #f8f9ff; padding: 30px 20px; text-align: center;">
      <p style="font-size: 12px; color: #666666; margin: 0 0 15px 0;">
        Best wishes,<br>
        The Presidy Team 🌟
      </p>
    </td>
  </tr>
</table>

{{>footer}}
