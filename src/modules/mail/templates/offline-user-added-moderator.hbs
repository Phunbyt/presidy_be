
<table width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; margin: 0 auto; font-family: 'Arial', sans-serif; color: #333333;">
  <!-- Header Section -->
  <tr>
    <td style="padding: 25px 0; text-align: center; background-color: #f8f9ff;">
      <img src="https://d3ezi03spn2dw7.cloudfront.net/darkLogo.png" alt="Presidy Logo" width="140" style="max-width: 140px;">
      <h2 style="color: #2A5CBE; margin: 15px 0 0 0;">✅ New Member Added to Your Family</h2>
    </td>
  </tr>

  <!-- Main Content -->
  <tr>
    <td style="padding: 30px 20px;">
      <h3 style="color: #2A5CBE; margin: 0 0 20px 0;">Hi {{moderatorName}},</h3>
      <p style="font-size: 16px; line-height: 1.6; margin: 0 0 20px 0;">
        A new member has been added to your <strong>{{planName}}</strong> family plan by the Presidy admin team.
      </p>

      <!-- New Member Details Card -->
      <div style="background: #F8F9FF; padding: 25px; margin: 20px 0; border-left: 4px solid #2A5CBE; border-radius: 4px;">
        <div style="margin-bottom: 12px;">
          <span style="display: block; color: #666; font-size: 14px; margin-bottom: 4px;">👤 Name</span>
          <span style="font-weight: bold; color: #2A5CBE;">{{memberName}}</span>
        </div>
        <div style="margin-bottom: 12px;">
          <span style="display: block; color: #666; font-size: 14px; margin-bottom: 4px;">✉️ Email</span>
          <span style="font-weight: bold; color: #2A5CBE;">{{memberEmail}}</span>
        </div>
        <div style="margin-bottom: 12px;">
          <span style="display: block; color: #666; font-size: 14px; margin-bottom: 4px;">📞 Phone</span>
          <span style="font-weight: bold; color: #2A5CBE;">{{memberPhone}}</span>
        </div>
        <div>
          <span style="display: block; color: #666; font-size: 14px; margin-bottom: 4px;">⏳ Subscription Duration</span>
          <span style="font-weight: bold; color: #2A5CBE;">{{subscriptionDuration}}</span>
        </div>
      </div>

      <p style="font-size: 14px; line-height: 1.6; color: #666;">
        Your family now has <strong>{{currentCount}}/{{familyLimit}}</strong> members.
      </p>
    </td>
  </tr>

  <!-- Footer -->
  <tr>
    <td style="background: #f8f9ff; padding: 25px 20px; text-align: center;">
      <p style="font-size: 12px; color: #666666; margin: 0;">
        This is an automated notification from Presidy Admin<br>
        <span style="display: inline-block; margin: 8px 0;">🔔</span>
      </p>
      <p style="font-size: 12px; color: #666666; margin: 15px 0 0 0;">
        Best wishes,<br>
        The Presidy Team 🌟
      </p>
    </td>
  </tr>
</table>

{{>footer}}
